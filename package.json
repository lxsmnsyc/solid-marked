{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm recursive run build",
    "clean": "pnpm recursive run clean",
    "cs:add": "changeset add",
    "cs:pub": "changeset publish",
    "cs:ver": "changeset version && pnpm install --lockfile-only",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "release": "node scripts/publish.ts",
    "test": "pnpm recursive run test",
    "type-check": "tsc --noEmit && pnpm recursive run type-check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lxsmnsyc/oxlint-config": "^0.1.3",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.6.0"
}
