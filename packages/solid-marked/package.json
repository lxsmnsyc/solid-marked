{
  "name": "solid-marked",
  "version": "0.7.0",
  "private": false,
  "description": "Markdown Compiler for SolidJS",
  "keywords": [
    "compiler",
    "markdown",
    "mdast",
    "mdx",
    "solid",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-marked/tree/main/packages/solid-marked",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-marked/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-marked.git"
  },
  "files": [
    "dist",
    "src",
    "compiler",
    "component",
    "env.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "compiler": [
        "./dist/compiler.d.ts"
      ],
      "component": [
        "./dist/component.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "default": "./dist/component.js"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./env.d.ts": {
      "types": "./env.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mdast-util-toc": "^7.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "seroval": "^1.6.4",
    "source-map": "^0.8.0",
    "toml": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "solid-js": "^1.9.15",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
