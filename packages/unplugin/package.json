{
  "name": "unplugin-solid-marked",
  "version": "1.0.0-next.0",
  "private": false,
  "description": "Universal bundler plugin for solid-marked",
  "keywords": [
    "markdown",
    "rollup",
    "solid",
    "solid-js",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-marked/tree/main/packages/unplugin",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-marked/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-marked.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "unplugin": "^3.7.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/node": "^26.6.6",
    "solid-js": "^2.0.0-rc.21",
    "solid-marked": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.21",
    "solid-marked": "workspace:^",
    "vite": "^8 || ^9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
